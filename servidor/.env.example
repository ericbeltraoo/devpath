# Copie para .env NA VPS e preencha. Este arquivo nunca vai para o git.

NODE_ENV=production
PORT=3001

# Origem permitida no CORS — o dominio do frontend
CORS_ORIGIN=https://estudo.lastweek.com.br

# MySQL — use o usuario devpath_app criado pelo schema.sql, nunca root
DB_HOST=localhost
DB_PORT=3306
DB_USER=devpath_app
DB_PASSWORD=
DB_NAME=devpath
DB_POOL=5

# Gere com: openssl rand -base64 48
# Precisa ter 32+ caracteres, senao a API se recusa a subir.
JWT_SECRET=

# Deixe true para criar sua conta; depois troque para false e reinicie.
CADASTRO_ABERTO=true
