# Copie para .env NA VPS e preencha. Este arquivo nunca vai para o git.

NODE_ENV=production
PORT=3001

# Origem permitida no CORS — o dominio do frontend
CORS_ORIGIN=https://estudo.lastweek.com.br

# MySQL — use o usuario devpath_app criado pelo schema.sql, nunca root
DB_HOST=localhost
DB_PORT=3306
DB_USER=devpath_app
DB_PASSWORD=
DB_NAME=devpath
DB_POOL=5

# Gere com: openssl rand -base64 48
# Precisa ter 32+ caracteres, senao a API se recusa a subir.
JWT_SECRET=

# Deixe true para criar sua conta; depois troque para false e reinicie.
CADASTRO_ABERTO=true

# Execucao de codigo dos exercicios (opcional).
# Padrao: instancia publica do Judge0, gratuita e sem chave.
# Se ela sair do ar ou passar a exigir chave — como o Piston fez em 02/2026 —
# troque a URL aqui ou hospede a sua propria. Nenhum codigo roda NESTA VPS.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_KEY=
