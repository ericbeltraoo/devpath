# Copie para .env NA VPS e preencha. Este arquivo nunca vai para o git.

NODE_ENV=production
PORT=3001

# Origem permitida no CORS — o dominio do frontend
CORS_ORIGIN=https://devpath.lastweek.com.br

# MySQL — usuario dedicado, NUNCA root.
# O schema.sql nao cria este usuario de proposito (senha em arquivo
# versionado e como se cria vazamento). Ele e criado na VPS, com senha
# gerada la: veja deploy/README.md, secao 2.2.
DB_HOST=localhost
DB_PORT=3306
DB_USER=devpath_app
DB_PASSWORD=
DB_NAME=devpath
DB_POOL=5

# Gere com: openssl rand -base64 48
# Precisa ter 32+ caracteres, senao a API se recusa a subir.
JWT_SECRET=

# Deixe true para criar sua conta; depois troque para false e reinicie.
CADASTRO_ABERTO=true

