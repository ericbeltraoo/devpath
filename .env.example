# Copie este arquivo para ".env" e preencha com as chaves do seu projeto Supabase.
# Onde achar: painel do Supabase -> Project Settings -> API
#
# IMPORTANTE: use a chave "anon / public". NUNCA use a "service_role" aqui —
# ela ignora as regras de seguranca (RLS) e ficaria exposta no navegador.
#
# Sem estas variaveis o app roda em modo local (sem login, sem sincronizacao).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
